          <AuxValues>
            <AuxValue name="JavaCodeGenerator_InitCodePost" type="java.lang.String" value="// Este c&#xf3;digo toma el &#xed;cono de la ciudad y lo re-escala&#xd;&#xa;javax.swing.ImageIcon icon = (javax.swing.ImageIcon) jLabel6.getIcon();&#xd;&#xa;java.awt.Image img = icon.getImage();&#xd;&#xa;&#xd;&#xa;// USA LOS N&#xda;MEROS EXACTOS (380x480) EN LUGAR DE getWidth()/getHeight()&#xd;&#xa;java.awt.Image newImg = img.getScaledInstance(380, 480, java.awt.Image.SCALE_SMOOTH);&#xd;&#xa;&#xd;&#xa;jLabel6.setIcon(new javax.swing.ImageIcon(newImg));"/>
          </AuxValues>
          <Constraints>
            <Constraint layoutClass="org.netbeans.modules.form.compat2.layouts.DesignAbsoluteLayout" value="org.netbeans.modules.form.compat2.layouts.DesignAbsoluteLayout$AbsoluteConstraintsDescription">
